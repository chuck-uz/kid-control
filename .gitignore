# Build output
[Bb]in/
[Oo]bj/
publish/
[Bb]uild/
artifacts/
*.user

# Rider / VS
.idea/
.vs/

# Secrets — never commit runtime config with a real bot token
**/appsettings.json
**/appsettings.Local.json
**/appsettings.Secrets.json
!**/appsettings.template.json
# Backend appsettings hold no secrets (empty conn string / localhost dev default) — keep them.
!src/KidControl.Backend/appsettings.json
!src/KidControl.Backend/appsettings.Development.json

# Rendered backend env (real secrets) — never commit; the template is committed.
deploy/.env

# Code-signing material — private key must never be committed
signing/
*.pfx
*.pfx.b64
*.cer
*.snk

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db
