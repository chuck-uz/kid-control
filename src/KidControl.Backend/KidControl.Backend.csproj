<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Cross-platform (Linux container); no Windows targeting. -->
    <UserSecretsId>kidcontrol-backend</UserSecretsId>
    <!-- EF analyzer noise shouldn't fail the build; CS warnings still do (Directory.Build.props). -->
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KidControl.Fleet.Contracts\KidControl.Fleet.Contracts.csproj" />
    <ProjectReference Include="..\KidControl.Domain\KidControl.Domain.csproj" />
  </ItemGroup>
</Project>
