<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!--
      Windows TFM: this project talks to the SCM, the Windows ACL engine and the
      registry, so it must target -windows. It contains NO WinForms/UI so it stays
      unit-testable in isolation (run the tests on the windows-latest CI runner).
      The net*-windows targeting pack supplies Microsoft.Win32.Registry,
      System.Security.AccessControl and System.Security.Principal.Windows in-box.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" />
  </ItemGroup>

  <!--
    Default fleet backend URL, pre-filled in the enrollment window. Not in git: it comes from
    the untracked Directory.Build.local.props (KcBackendUrl) or the KC_BACKEND_URL environment
    variable at build time. Empty = no default; the operator must enter the URL.
    Read at runtime from AssemblyMetadata("KcBackendUrl") by FleetConfigWriter.
  -->
  <PropertyGroup>
    <KcBackendUrl Condition="'$(KcBackendUrl)' == ''">$(KC_BACKEND_URL)</KcBackendUrl>
  </PropertyGroup>
  <ItemGroup Condition="'$(KcBackendUrl)' != ''">
    <AssemblyMetadata Include="KcBackendUrl" Value="$(KcBackendUrl)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KidControl.Contracts\KidControl.Contracts.csproj" />
  </ItemGroup>
</Project>
