<Window x:Class="KidControl.UiHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kid Control"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        Width="280"
        Height="96"
        FontFamily="Segoe UI, Segoe UI Variable Text"
        Opacity="1">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Border x:Name="WidgetBorder"
                Visibility="{Binding IsWidgetVisible, Converter={StaticResource BoolToVis}}"
                Width="280"
                Height="96"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,10,0"
                Background="#BF333333"
                BorderBrush="#10FFFFFF"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16"
                SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="50"
                      Height="50"
                      Margin="0,0,10,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center">
                    <Ellipse Stroke="#FF444444"
                             StrokeThickness="5" />
                    <Path x:Name="WidgetProgressPath"
                          Stroke="DodgerBlue"
                          StrokeThickness="5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Grid>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <TextBlock Text="KidControl"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFFFF" />
                    <TextBlock Text="{Binding SessionLabel}"
                               FontSize="8"
                               Margin="0,2,0,0"
                               FontWeight="Normal"
                               Foreground="#FFAAAAAA" />
                    <TextBlock x:Name="WidgetTimerText"
                               Text="{Binding TimeRemainingStr}"
                               FontSize="20"
                               Margin="0,3,0,0"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFFFF" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="BlockOverlay"
                Background="{StaticResource BlockBackgroundBrush}"
                Visibility="Collapsed">
            <Grid>
                <Canvas IsHitTestVisible="False" Opacity="0.55">
                    <Ellipse x:Name="Star1" Fill="#55FFFFFF" Width="3" Height="3" Canvas.Left="150" Canvas.Top="120" />
                    <Ellipse x:Name="Star2" Fill="#40FFFFFF" Width="4" Height="4" Canvas.Left="520" Canvas.Top="250" />
                    <Ellipse x:Name="Star3" Fill="#45FFFFFF" Width="3" Height="3" Canvas.Left="860" Canvas.Top="170" />
                    <Ellipse x:Name="Star4" Fill="#35FFFFFF" Width="5" Height="5" Canvas.Left="1180" Canvas.Top="320" />
                    <Ellipse x:Name="Star5" Fill="#50FFFFFF" Width="3" Height="3" Canvas.Left="1460" Canvas.Top="140" />
                </Canvas>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Margin="24">
                    <TextBlock Text="KidControl"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20" />
                    <TextBlock Text="Время игры закончилось. Перерыв."
                               x:Name="BlockReasonText"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontWeight="SemiBold"
                               FontSize="44"
                               Margin="0,0,0,28"
                               TextAlignment="Center"
                               LineHeight="56"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="BlockedTimerText"
                               Text="{Binding BlockCountdownText}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource UiFontFamily}"
                               FontSize="96"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
