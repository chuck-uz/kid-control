{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\ProgramData\\KidControl\\logs\\service-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      },
      {
        "Name": "File",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact",
          "path": "C:\\ProgramData\\KidControl\\logs\\service-ai-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "Telegram": {
    "BotToken": "",
    "AdminChatIds": [],
    "NightStart": "22:00:00",
    "NightEnd": "07:00:00"
  },
  "Fleet": {
    "_comment": "Leave Url empty for standalone (embedded bot). Set Url + EnrollCode once to enroll into managed mode.",
    "Url": "",
    "EnrollCode": "",
    "HeartbeatInterval": "00:00:30",
    "CommandPollTimeout": "00:00:50"
  },
  "Update": {
    "Enabled": true,
    "AutoInstall": true,
    "CheckInterval": "06:00:00",
    "Owner": "chuck-uz",
    "Repository": "kid-control",
    "RequireSignature": true,
    "TrustedThumbprint": ""
  },
  "Protection": {
    "CriticalProcess": false,
    "ApplyProcessDacl": true,
    "TamperDetection": true
  }
}
