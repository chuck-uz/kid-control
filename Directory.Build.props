<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Compiler (CS) warnings are errors so real correctness drift is caught early.
         Analyzer (CA) suggestions stay as visible warnings, not build-breakers — rules
         like CA1848 (LoggerMessage delegates) aren't worth failing a build over here. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Product>KidControl</Product>
    <Company>KidControl</Company>
    <Authors>KidControl</Authors>
    <!-- Reproducible builds: MinVer version is pinned, not floating. Tag vX.Y.Z to release.
         MinVerTagPrefix=v is REQUIRED so a "v2.0.0" tag stamps version 2.0.0; without it
         MinVer ignores the v-prefixed tag and every build reports 0.0.0-alpha, which would
         silently break the self-update version comparison. -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" PrivateAssets="All" />
  </ItemGroup>
</Project>
