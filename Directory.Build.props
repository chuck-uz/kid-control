<Project>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Product>KidControl</Product>
    <Company>KidControl</Company>
  </PropertyGroup>

  <!-- Version is derived automatically from git tags by MinVer.
       Tag the commit: git tag v1.0.1 then git push with the tags flag.
       MinVer sets Version/AssemblyVersion/FileVersion = 1.0.1 -->
  <ItemGroup>
    <PackageReference Include="MinVer" Version="4.*" PrivateAssets="All" />
  </ItemGroup>
</Project>
